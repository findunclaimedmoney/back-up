{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "pro",
        "vip"
      ],
      "default": "free",
      "description": "The user's subscription tier"
    },
    "video_minutes_used": {
      "type": "number",
      "default": 0,
      "description": "Video minutes consumed this billing period"
    },
    "video_minutes_limit": {
      "type": "number",
      "default": 0,
      "description": "Max video minutes for this tier per month"
    },
    "intimacy_package": {
      "type": "boolean",
      "default": false,
      "description": "Whether intimacy is included in the user's tier (pro/vip)"
    },
    "intimacy_sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "duration_minutes": {
            "type": "number",
            "description": "Session length purchased"
          },
          "purchased_date": {
            "type": "string",
            "format": "date-time",
            "description": "When the session was purchased"
          },
          "used": {
            "type": "boolean",
            "default": false,
            "description": "Whether this session has been consumed"
          }
        }
      },
      "default": [],
      "description": "Purchased intimacy session slots \u2014 buy as many as you want, use them when you're ready"
    },
    "intimacy_training_stage": {
      "type": "number",
      "default": 0,
      "description": "Current intimacy training progression stage (0=First Glances, 1=Finding Rhythm, 2=Opening Up, 3=Deepening Bond, 4=Ready)"
    },
    "twin_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Twin/Clone companion feature is available"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "When the current billing period ends"
    }
  },
  "required": []
}
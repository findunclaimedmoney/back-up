{
  "name": "CustomCompanion",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name given to the custom companion"
    },
    "tagline": {
      "type": "string",
      "description": "Short descriptor shown on cards"
    },
    "description": {
      "type": "string",
      "description": "Longer description of personality"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded photo"
    },
    "personality": {
      "type": "string",
      "description": "System prompt describing how the companion should behave"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ],
      "default": "ready",
      "description": "draft = still being set up; ready = available to chat"
    },
    "source": {
      "type": "string",
      "enum": [
        "anam"
      ],
      "default": "anam",
      "description": "Which video engine powers this companion (custom = Anam instant)"
    },
    "avatar_id": {
      "type": "string",
      "description": "LiveAvatar avatar ID once the By Image processing is complete"
    },
    "avatar_status": {
      "type": "string",
      "enum": [
        "processing",
        "active",
        "failed"
      ],
      "default": "processing",
      "description": "Status of the custom LiveAvatar image avatar creation: processing (up to 24hrs), active (ready for video), failed"
    }
  },
  "required": [
    "name",
    "image_url",
    "personality"
  ]
}
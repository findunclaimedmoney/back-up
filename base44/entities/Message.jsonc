{
  "name": "Message",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Who sent the message"
    },
    "content": {
      "type": "string",
      "description": "The text content of the message"
    },
    "companion_id": {
      "type": "string",
      "description": "Which companion this message belongs to"
    }
  },
  "required": [
    "role",
    "content",
    "companion_id"
  ]
}
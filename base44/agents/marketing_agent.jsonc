      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "generateMarketingReport",
      "description": "Generate on-demand weekly marketing performance reports"
    },
    {
      "function_name": "getDashboardStats",
      "description": "Pull real-time platform metrics \u2014 users, revenue, sessions, active subscriptions"
    }
